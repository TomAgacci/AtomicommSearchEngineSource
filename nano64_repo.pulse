<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>nano64 Engine Demo</title>
  <style>
    body {
      margin:0;
      background:#000;
      display:flex;
      align-items:center;
      justify-content:center;
      height:100vh;
      font-family:sans-serif;
    }
    .tv-shell {
      background:#111;
      padding:24px 32px;
      border-radius:32px;
      box-shadow:0 0 40px #0f0;
      border:4px solid #333;
      position:relative;
    }
    .tv-screen {
      width:640px;
      height:480px; /* 4:3 */
      background:#020308;
      border-radius:12px;
      overflow:hidden;
      border:3px solid #222;
      position:relative;
    }
    canvas { display:block; }
    .scanlines {
      pointer-events:none;
      position:absolute;
      inset:0;
      background:repeating-linear-gradient(
        to bottom,
        rgba(255,255,255,0.04) 0px,
        rgba(255,255,255,0.04) 1px,
        rgba(0,0,0,0.0) 2px,
        rgba(0,0,0,0.0) 3px
      );
      mix-blend-mode:soft-light;
    }
    .tv-label {
      position:absolute;
      right:24px;
      bottom:10px;
      color:#0f0;
      font-size:10px;
      letter-spacing:2px;
      text-transform:uppercase;
      opacity:0.7;
    }
  </style>
</head>
<body>
  <div class="tv-shell">
    <div class="tv-screen">
      <canvas id="view" width="640" height="480"></canvas>
      <div class="scanlines"></div>
    </div>
    <div class="tv-label">nano64</div>
  </div>
  <script type="module" src="./main.js"></script>
</body>
</html>
